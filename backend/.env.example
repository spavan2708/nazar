LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=15

# Requested OCR language packs; unavailable packs fall back with a setup notice.
# Use eng for Latin-only screenshots, including Hinglish and Tanglish.
OCR_LANGUAGES=eng+hin+tam

# Local multilingual whisper.cpp model; relative paths resolve from backend/.
WHISPER_MODEL_PATH=stt/models/ggml-base.bin
WHISPER_LANGUAGE=auto
WHISPER_TIMEOUT_SECONDS=120

# Expose up to two synthetic training references per class (no query caching).
# Set false before using private/user-derived reference data.
ML_EXPLANATIONS_ENABLED=true

# Local curated official guidance; build with python -m rag.build_index.
RAG_ENABLED=true

# Optional offline QR extraction (requires requirements-vision.txt).
QR_ENABLED=false
